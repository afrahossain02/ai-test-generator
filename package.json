{
  "name": "ai-test-generator",
  "version": "0.1.0",
  "description": "Turns user stories into structured, executable test cases using AI.",
  "type": "module",
  "bin": {
    "ai-testgen": "./src/cli.js"
  },
  "main": "./src/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/cli.js generate --story examples/sample-user-story.txt --dry-run",
    "codegen": "node src/cli.js codegen --plan examples/saucedemo-testplan.json --name saucedemo",
    "test": "vitest run",
    "test:generated": "npm run codegen && playwright test",
    "check": "for f in $(find src -name '*.js'); do node --check \"$f\" || exit 1; done && node --check playwright.config.js"
  },
  "keywords": [
    "testing",
    "qa",
    "test-cases",
    "ai",
    "claude",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vitest": "^3.2.4"
  }
}
